PORT=5000
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=your_supabase_postgres_connection_string_here
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# AI Provider — works with ANY OpenAI-compatible provider
# ─────────────────────────────────────────────────────────────

# OPTION 1: Groq (RECOMMENDED — 14,400 free req/day, no credit card)
# Get key: https://console.groq.com → API Keys → Create API Key
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# OPTION 2: OpenRouter (access to many free models)
# AI_API_KEY=your_openrouter_key_here
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OPTION 3: OpenAI (paid)
# AI_API_KEY=your_openai_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# OPTION 4: Gemini (via OpenAI-compatible endpoint, 1500 free req/day)
# AI_API_KEY=your_gemini_key_here
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.0-flash

# OPTION 5: Cloudflare Workers AI (free tier available)
# Get key: https://dash.cloudflare.com → AI → API Tokens
# Replace ACCOUNT_ID with your Cloudflare account ID
# AI_API_KEY=your_cloudflare_api_token_here
# AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast